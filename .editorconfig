root = true

# 只放 C# 命名规则，取自中康 ZKMedicalSystem\.editorconfig 的 [*.cs] 一节（只多了下面 IDE1006 一行）；编码与行尾不在这里统一（本工程改文件守原行尾）。
[*.cs]
# 命令行构建只认诊断级别的严重度，下面各条命名规则自带的 severity 只在编辑器里生效；这一行让 IDE1006（命名违规）在构建时报错（本工程加，中康原版没有）。
dotnet_diagnostic.IDE1006.severity = error
# 封闭取值（枚举）的 switch 写全具名取值即可，不写兜底分支：漏了具名取值的 CS8509 照样报错；只关掉「未命名的数值没处理」的 CS8524，
# 那种值只能靠强制转换造出来，真出现时运行时抛 SwitchExpressionException，不会被兜底读成别的状态（本工程加）。
dotnet_diagnostic.CS8524.severity = none

# 接口统一使用 I 前缀；类型和公开成员统一 PascalCase。
dotnet_naming_rule.interfaces_must_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_must_start_with_i.style = interface_prefix
dotnet_naming_rule.interfaces_must_start_with_i.severity = error

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = public, internal, protected, protected_internal, private_protected

dotnet_naming_style.interface_prefix.required_prefix = I
dotnet_naming_style.interface_prefix.capitalization = pascal_case

dotnet_naming_rule.types_use_pascal_case.symbols = types
dotnet_naming_rule.types_use_pascal_case.style = pascal_case
dotnet_naming_rule.types_use_pascal_case.severity = error

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_symbols.types.applicable_accessibilities = public, internal, protected, protected_internal, private_protected, private

dotnet_naming_rule.public_members_use_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_use_pascal_case.style = pascal_case
dotnet_naming_rule.public_members_use_pascal_case.severity = error

dotnet_naming_symbols.public_members.applicable_kinds = property, method, event
dotnet_naming_symbols.public_members.applicable_accessibilities = public, internal, protected, protected_internal, private_protected

# 参考工程采用字段前缀，但存在 _PascalCase 等漂移；本工程固定为 _camelCase。
# 存量字段已完成符号级迁移，新代码违反该规则时直接阻断构建。
dotnet_naming_rule.private_readonly_fields_use_underscore.symbols = private_readonly_fields
dotnet_naming_rule.private_readonly_fields_use_underscore.style = underscore_camel_case
dotnet_naming_rule.private_readonly_fields_use_underscore.severity = error

dotnet_naming_symbols.private_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_readonly_fields.required_modifiers = readonly

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

dotnet_naming_style.pascal_case.capitalization = pascal_case
