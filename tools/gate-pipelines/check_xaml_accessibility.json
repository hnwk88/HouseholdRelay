{
  "rule": "check_xaml_accessibility",
  "pipeline": [
    {
      "combinator": "sequence",
      "steps": [
        {
          "step": "selectFiles",
          "where": [
            {
              "type": "extension",
              "value": [
                ".xaml"
              ]
            },
            {
              "type": "root",
              "value": [
                "src",
                "tests",
                "tools"
              ]
            },
            {
              "type": "excludeFolder",
              "value": [
                "{scan.ignoredDirectories}"
              ]
            }
          ]
        },
        {
          "step": "find",
          "patterns": [
            {
              "id": "编辑器",
              "type": "expression",
              "value": "<avalonedit:TextEditor(?=[\\s>/]).*?(?:/>|>)",
              "dotAll": true
            }
          ]
        },
        {
          "combinator": "forEach",
          "each": "片段",
          "body": [
            {
              "combinator": "if",
              "condition": [
                {
                  "step": "assert",
                  "predicate": "notContains",
                  "values": [
                    {
                      "type": "text",
                      "value": "AccessibleAvalonTextEditor"
                    }
                  ]
                }
              ],
              "then": [
                {
                  "step": "emit",
                  "rule": "avalonedit-textpattern-provider",
                  "severity": "error",
                  "message": "发现直接使用 AvalonEdit TextEditor，可能缺少焦点层 TextPattern 支持。",
                  "suggestion": "改用 `AccessibleAvalonTextEditor` 或等价自定义 AutomationPeer，确保外层编辑器和内部 TextArea 都能返回 `ITextProvider`。"
                }
              ]
            }
          ]
        }
      ]
    },
