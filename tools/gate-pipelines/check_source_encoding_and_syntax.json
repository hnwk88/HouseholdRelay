{
  "解法": "完整管线",
  "rule": "check_source_encoding_and_syntax",
  "说明": {
    "护住什么": "DOC-MOJIBAKE-001 与用户点名的「缺 bom 的那条门禁」：源码与文档要带 UTF-8 BOM、要是合法 UTF-8、不许有编码误读留下的乱码。乱码两种判法都要（用户定）：按行报确凿标记或一行里累计的标记，按行没有时再看整份门槛，抓分散的乱码。",
    "从哪来": "A0cf：原先是内置 C# 判据 SourceEncodingVerdict，阶段一第 1 件把它从只给 MyCoAI 放宽成所有工程、还把 SBT 用配置写的乱码检查并了进去——违反 D-071（用户：「用配置，不要内置判据，内部解」）。这里按同一口径写成配置，用底座新加的解法「文本编码」（看原始字节）；与旧判据在四个工程真实代码上对拍后删掉那份 C#。",
    "三段各管什么": "缺 BOM 一段排除机器协议文件（Claude Code、Codex 与引擎自己读写的那几份，格式由它们定，不要求 BOM）；不是 UTF-8、乱码两段看全部。一段只查一件事，三件事管的文件不一样，靠各段的「在哪」「排除」分开，不做模式开关。",
    "三段为什么这样排": "「不是 UTF-8」排第一：它读全轮共享的正文，读的时候顺手记下有没有 BOM，排在后面的「缺 BOM」就不必再开文件。次序不影响结论。",
    "工程自己的事实": "只在乱码那一段免查的文件（存着乱码样例的工具）写在「例外」里，并点「只在：乱码」。",
    "这份配置自己为什么不报乱码": "这份配置自己存着乱码样例（「乱码标记」那一格），乱码那一段把它排除在判据里（「排除」），而不是写成例外：例外是各工程自己的事实、安装与升级都不带，新工程拿到的配置没有它就会把自己报成乱码（2026-10-09 模拟新用户安装时撞到）。"
  },
  "pipeline": [
    {
      "step": "解法",
      "as": "不是UTF8",
      "解法": "文本编码",
      "rule": "check_source_encoding_and_syntax",
      "在哪": [
        {
          "正则": "."
        }
      ],
      "扩展名": [
        ".cs",
        ".json",
        ".md",
        ".ps1",
        ".py",
        ".xaml"
      ],
      "查": "不是 UTF-8",
      "严重度": "error"
    },
    {
      "step": "解法",
      "as": "缺BOM",
      "解法": "文本编码",
      "rule": "check_source_encoding_and_syntax",
      "在哪": [
        {
          "正则": "."
        }
      ],
      "排除": [
        {
          "正则": "^\\.claude/settings\\.json$"
        },
        {
          "正则": "^\\.codex/hooks\\.json$"
        },
        {
          "正则": "^tools/gate-engine\\.install\\.json$"
        },
        {
          "正则": "^\\.gate-engine/native-hooks\\.json$"
        }
      ],
      "扩展名": [
        ".cs",
        ".json",
        ".md",
        ".ps1",
        ".py",
        ".xaml"
      ],
      "查": "缺 BOM",
      "严重度": "error",
      "做法": "检查并修复"
    },
    {
      "step": "解法",
      "as": "乱码",
      "解法": "文本编码",
      "rule": "check_source_encoding_and_syntax",
      "在哪": [
        {
          "正则": "."
        }
      ],
      "扩展名": [
        ".cs",
        ".json",
        ".md",
        ".ps1",
        ".py",
        ".xaml"
      ],
      "查": "乱码",
      "严重度": "error",
      "乱码标记": [
        "�",
        "锟斤拷",
        "琛ㄧ",
        "璇嶆",
        "鐐瑰",
        "鐩叉",
        "鎵€",
        "寮€",
        "涓€",
        "鏄",
        "宸插",
        "寰呮",
        "杩炴",
        "闂",
        "鍓嶇",
        "鍚庣",
        "銆?",
        "锛?"
      ],
      "确凿标记": [
        "�",
        "锟斤拷"
      ],
      "一行几处算": 3,
      "整份几处算": 8,
      "整份几种算": 4,
      "去掉代码块的扩展名": [
        ".md"
      ],
      "排除": [
        {
          "正则": "(^|/)tools/gate-pipelines/check_source_encoding_and_syntax\\.json$"
        }
      ]
    }
  ]
}
