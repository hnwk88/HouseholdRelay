{
  "schemaVersion": 1,
  "projectName": "HouseholdRelay",
  "cacheDirectory": ".gate-cache",
  "scan": {
    "roots": [
      "src",
      "tests",
      "tools",
      "docs"
    ],
    "extensions": [
      ".cs",
      ".xaml",
      ".cshtml",
      ".js",
      ".cjs",
      ".css",
      ".html",
      ".py",
      ".json",
      ".md",
      ".ps1"
    ],
    "ignoredDirectories": [
      "bin",
      "obj",
      ".git",
      "artifacts",
      "__pycache__",
      "publish",
      ".vs",
      "node_modules"
    ]
  },
  "levels": {
    "L0": {
      "enabled": true,
      "budgetSeconds": 1.0,
      "blocking": false
    },
    "L1": {
      "enabled": true,
      "budgetSeconds": 60.0,
      "blocking": false
    },
    "L2": {
      "enabled": true,
      "budgetSeconds": 90.0,
      "blocking": true
    },
    "L3": {
      "enabled": true,
      "budgetSeconds": null,
      "blocking": true
    }
  },
  "rules": {
    "textFiles": [
      "门禁认领编号.md"
    ]
  }
}
