@page
@model UpstreamModel
@{ ViewData["Title"] = "上游接入"; }
<p class="eyebrow">共享上游</p><h1>上游接入</h1>
<p>起个名字，填地址，贴密钥，按「获取模型」。认证方式和检测方式由程序自己判断；测通过后按名称切换，在途请求不受影响。</p>
<div asp-validation-summary="All" role="alert"></div>
@if (Model.Notice is not null) { <p class="notice" role="status">@Model.Notice</p> }
<section class="card" aria-labelledby="active-heading"><h2 id="active-heading">当前使用的上游</h2>
    @if (Model.Active.Configured)
    {
        <p>名称：@(Model.Active.Name ?? "未命名")</p>
        <p class="status">@Model.RuntimeStatus</p>
        <p>@UpstreamModel.AccessText(Model.Active.Options) · 认证用 @UpstreamDetection.AuthenticationLabel(Model.Active.Options.Authentication) · 按 @UpstreamDetection.DiagnosticLabel(Model.Active.Options.Diagnostic) 方式检测 · 模型 @(Model.Active.Options.Model.Length == 0 ? "未填写" : Model.Active.Options.Model)</p>
        <p>Messages 地址：<code>@UpstreamAddress.Endpoint(Model.Active.Options, "/v1/messages")</code></p>
        <p>@(Model.Active.Options.OfficialLogin ? "凭据：由登录得到，Claude Code 到期前自动刷新，不用重新粘贴。" : "凭据：已配置；到期时间未知。")</p>
    }
    else
    {
        <p class="status">@Model.RuntimeStatus</p>
        <p>还没有上游。请在下面的「API 供应商」里起名字、填地址、贴密钥，然后按「获取模型」。</p>
    }
</section>
@if (Model.Working is { } working)
{
    <section class="card" aria-labelledby="test-heading" id="test"><h2 id="test-heading">选择模型并测试：@working.Name</h2>
        <p>认证方式：@UpstreamModel.AuthenticationText(working)</p>
        <p>@UpstreamModel.ResultText(working)</p>
        <form method="post" asp-page-handler="Test"><input type="hidden" name="candidateId" value="@working.Id" />
            @if (working.Report?.Models is { Length: > 0 } models)
            {
                <label for="test-model">模型</label>
                <select id="test-model" name="model">
                    @foreach (var item in models) { <option value="@item" selected="@(item == working.Options.Model)">@item</option> }
                </select>
            }
            else
            {
                <label for="test-model">模型名称（上游没有提供模型目录，请手填）</label>
                <input id="test-model" name="model" value="@working.Options.Model" maxlength="200" required />
            }
            <button type="submit" class="secondary">测试（会消耗少量上游额度）</button>
            <small>这是管理员诊断，不计入个人用量；测试不会切换当前上游。</small>
        </form>
        @if (working.State == "passed" && working.Id != Model.Active.CandidateId)
        { <form method="post" asp-page-handler="Activate"><input type="hidden" asp-for="Version" /><input type="hidden" name="candidateId" value="@working.Id" /><button type="submit">切换到「@working.Name」</button></form> }
    </section>
}
@if (Model.Saved.Count > 0)
{
    <section class="card" aria-labelledby="saved-heading"><h2 id="saved-heading">已保存的上游（@Model.Saved.Count 个）</h2>
        @foreach (var item in Model.Saved)
        {
            <article class="saved-upstream" aria-labelledby="saved-@item.Id"><h3 id="saved-@item.Id">@item.Name@(item.Id == Model.Active.CandidateId ? "（当前使用中）" : "")</h3>
                <dl><dt>地址</dt><dd><code>@item.Options.BaseUrl</code></dd>
                    <dt>接入方式</dt><dd>@UpstreamModel.AccessText(item.Options)</dd>
                    <dt>认证方式</dt><dd>@UpstreamModel.AuthenticationText(item)</dd>
                    <dt>模型</dt><dd>@(item.Options.Model.Length == 0 ? "尚未选择" : item.Options.Model)</dd>
                    <dt>最近一次检测</dt><dd>@UpstreamModel.ResultText(item)</dd></dl>
                @if (item.State == "passed" && item.Id != Model.Active.CandidateId && item.Id != Model.Working?.Id)
                { <form method="post" asp-page-handler="Activate"><input type="hidden" asp-for="Version" /><input type="hidden" name="candidateId" value="@item.Id" /><button type="submit">切换到「@item.Name」</button></form> }
                <a asp-page="/Upstream" asp-route-candidateId="@item.Id" asp-fragment="test">选择模型并测试「@item.Name」</a>
                <form method="post" asp-page-handler="Rediscover"><input type="hidden" name="candidateId" value="@item.Id" />
                    <button type="submit" class="secondary">重新获取「@item.Name」的模型（不花额度）</button>
                </form>
                <form method="post" asp-page-handler="Rename"><input type="hidden" name="candidateId" value="@item.Id" />
                    <label for="rename-@item.Id">「@item.Name」的新名称</label><input id="rename-@item.Id" name="newName" maxlength="40" required />
                    <button type="submit" class="secondary">改名</button>
                </form>
                @if (item.Deletable)
                {
                    <form method="post" asp-page-handler="Delete"><input type="hidden" name="candidateId" value="@item.Id" />
                        <label class="checkbox"><input type="checkbox" name="deleteConfirmed" value="true" required />确认删除「@item.Name」（删除后不能恢复）</label>
                        <button type="submit" class="secondary">删除「@item.Name」</button>
                    </form>
                }
            </article>
        }
    </section>
}
<section class="card" aria-labelledby="api-heading"><h2 id="api-heading">API 供应商</h2>
    <p>只填三样：名称、地址、密钥。按下面的按钮会先加密保存这个上游，再读取它的模型目录；密钥只需输入这一次。</p>
    <form method="post" asp-page-handler="DiscoverApi" class="settings"><input type="hidden" asp-for="Version" />
        <label asp-for="Api.Name">供应商名称</label><input asp-for="Api.Name" maxlength="40" required placeholder="例如 aitoll、公司 sftoken" />
        <label asp-for="Api.BaseUrl">上游地址</label><input asp-for="Api.BaseUrl" type="url" maxlength="2048" required placeholder="https://api.example.com" />
        <label asp-for="Api.Credential">API 密钥</label><input asp-for="Api.Credential" type="password" autocomplete="new-password" maxlength="8192" required />
        <details><summary>高级设置（一般不用改）</summary>
            <label asp-for="Api.Authentication">认证方式</label><select asp-for="Api.Authentication"><option value="auto">自动判断（推荐）</option><option value="x-api-key">x-api-key</option><option value="bearer">Bearer</option></select>
            <label asp-for="Api.Diagnostic">检测方式</label><select asp-for="Api.Diagnostic"><option value="auto">自动判断（推荐）</option><option value="messages">标准 Messages</option><option value="claude-code">Claude Code 实际调用（需本机安装）</option></select>
            <small>手动指定后，程序只用你选的那一种，结果里会注明「手动指定」。</small>
            <label class="checkbox"><input asp-for="Api.AllowPrivateNetwork" />允许连接本机或私网地址（包括 HTTP）</label>
        </details>
        <button type="submit">获取模型（不花额度）</button>
    </form>
</section>
<section class="card" aria-labelledby="account-heading"><h2 id="account-heading">官方账户</h2>
    <h3 id="account-login-heading">登录官方账户</h3>
    <p>按「登录官方账户」后，程序会让本机的 Claude Code 打开浏览器登录页（任务栏里会多一个最小化的 Claude Code 窗口，不用管它）。在浏览器里登录完，这一页会自动显示结果并读取模型目录。登录凭据只存在中转自己的数据目录里，不碰本机 Claude Code 自己的登录；到期前自动刷新，不用重新粘贴。</p>
    <form method="post" asp-page-handler="LoginAccount" class="settings" aria-labelledby="account-login-heading"><input type="hidden" asp-for="Version" />
        <label asp-for="Login.Name">账户名称（可不填，不填就用登录邮箱）</label><input asp-for="Login.Name" maxlength="40" placeholder="例如 我的 Claude 账户" />
        <details><summary>登录的高级设置（一般不用改）</summary>
            <label asp-for="Login.BaseUrl">登录用的上游地址</label><input asp-for="Login.BaseUrl" type="url" maxlength="2048" required />
            <label class="checkbox"><input asp-for="Login.AllowPrivateNetwork" />允许登录用的上游是本机或私网地址（包括 HTTP）</label>
        </details>
        <button type="submit">登录官方账户</button>
    </form>
    <h3 id="account-import-heading">或者导入登录文件</h3>
    <p>在另一台 Windows 电脑上登录过 Claude Code 的，把那台电脑的 <code>%USERPROFILE%\.claude\.credentials.json</code>（.claude 是隐藏文件夹）拷过来，在这里选它导入。导入后这份登录只给中转用，那台电脑请不要再用它，否则两边会互相挤掉登录；到期前由本机的 Claude Code 自动刷新。</p>
    <form method="post" asp-page-handler="ImportAccount" enctype="multipart/form-data" class="settings" aria-labelledby="account-import-heading"><input type="hidden" asp-for="Version" />
        <label asp-for="ImportFile">登录文件（.credentials.json）</label><input asp-for="ImportFile" type="file" accept=".json" required />
        <label asp-for="Import.Name">导入的账户名称（可不填，不填就用登录邮箱）</label><input asp-for="Import.Name" maxlength="40" placeholder="例如 我的 Claude 账户" />
        <details><summary>导入的高级设置（一般不用改）</summary>
            <label asp-for="Import.BaseUrl">导入用的上游地址</label><input asp-for="Import.BaseUrl" type="url" maxlength="2048" required />
            <label class="checkbox"><input asp-for="Import.AllowPrivateNetwork" />允许导入用的上游是本机或私网地址（包括 HTTP）</label>
        </details>
        <button type="submit">导入登录文件</button>
    </form>
    <h3 id="account-token-heading">或者贴已有的账户访问令牌</h3>
    <form method="post" asp-page-handler="DiscoverAccount" class="settings" aria-labelledby="account-token-heading"><input type="hidden" asp-for="Version" />
        <label asp-for="Account.Name">账户名称</label><input asp-for="Account.Name" maxlength="40" required placeholder="例如 我的 Claude 账户" />
        <label asp-for="Account.BaseUrl">贴令牌用的上游地址</label><input asp-for="Account.BaseUrl" type="url" maxlength="2048" required />
        <label asp-for="Account.Credential">账户访问令牌</label><input asp-for="Account.Credential" type="password" autocomplete="new-password" maxlength="8192" required />
        <details><summary>贴令牌的高级设置（一般不用改）</summary>
            <label class="checkbox"><input asp-for="Account.OAuthBeta" />兼容中转的账户模式也需要 OAuth beta（官方地址总会附加）</label>
            <label class="checkbox"><input asp-for="Account.AllowPrivateNetwork" />允许贴令牌用的上游是本机或私网地址（包括 HTTP）</label>
        </details>
        <button type="submit">用账户令牌获取模型（不花额度）</button>
    </form>
</section>
