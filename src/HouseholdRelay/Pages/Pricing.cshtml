@page
@model PricingModel
@{ ViewData["Title"] = "估算费率"; }
<p class="eyebrow">用量金额</p><h1>模型估算费率</h1>
<p>金额优先采用上游明确返回的费用。没有返回费用时，可按这里的单价估算四类 Token 金额；没有配置则显示未知。</p>
<p>估算不等于实际账单，不包括工具等其他收费。请按供应商的实际定价填写；缓存价格随缓存时长或方案不同时，应填写适用于当前调用的费率。</p>
<p>费率按上游分别设置：自动切换换到哪一家，那次请求就按那一家的费率估算。历史记录保存发送时的费率。</p>
<div asp-validation-summary="All" role="alert"></div>
@if (Model.Notice is not null) { <p class="notice" role="status">@Model.Notice</p> }
@if (Model.Saved.Count == 0)
{
    <p class="status">还没有已保存的上游。请先到 <a asp-page="/Upstream">上游接入</a> 接入一家，再回来填写费率。</p>
    return;
}
<form method="get" class="card usage-filters">
    <div><label for="pricing-upstream">上游</label>
        <select id="pricing-upstream" name="candidateId">
            @foreach (var item in Model.Saved) { <option value="@item.Id" selected="@(item.Id == Model.Selected?.Id)">@item.Name@(item.Id == Model.ActiveId ? "（在用）" : "")</option> }
        </select></div>
    <div class="full"><button type="submit">查看这家的费率</button></div>
</form>
@if (Model.Selected is null)
{
    <p class="status">所选的上游已不存在，请在上面重新选择。</p>
    return;
}
<h2>正在设置：@Model.Selected.Name</h2>
<form method="post" class="card usage-filters">
    <input asp-for="CandidateId" type="hidden" />
    <div><label asp-for="ModelName">模型（精确匹配）</label><input asp-for="ModelName" maxlength="160" required /></div>
    <div><label asp-for="Currency">币种代码</label><input asp-for="Currency" maxlength="3" required placeholder="例如 USD 或 CNY" /></div>
    <div><label asp-for="InputPrice">输入单价 / 百万 Token</label><input asp-for="InputPrice" type="number" min="0" max="1000000" step="any" /></div>
    <div><label asp-for="OutputPrice">输出单价 / 百万 Token</label><input asp-for="OutputPrice" type="number" min="0" max="1000000" step="any" /></div>
    <div><label asp-for="CacheReadPrice">缓存读取单价 / 百万 Token</label><input asp-for="CacheReadPrice" type="number" min="0" max="1000000" step="any" /></div>
    <div><label asp-for="CacheWritePrice">缓存写入单价 / 百万 Token</label><input asp-for="CacheWritePrice" type="number" min="0" max="1000000" step="any" /></div>
    <div class="full"><p>未知单价留空，明确免费才填 0。缺少用量或单价时，已有部分金额会标记为不完整。</p><button type="submit">保存估算费率</button> <a asp-page="/Usage">返回用量</a></div>
</form>
@foreach (var price in Model.Prices)
{
    <section class="card"><h2>@price.Model · @price.Currency</h2>
        <p>每百万 Token：输入 @(price.InputPerMillion?.ToString() ?? "未知") · 输出 @(price.OutputPerMillion?.ToString() ?? "未知") · 缓存读 @(price.CacheReadPerMillion?.ToString() ?? "未知") · 缓存写 @(price.CacheWritePerMillion?.ToString() ?? "未知")</p>
        <a asp-page="/Pricing" asp-route-candidateId="@price.CandidateId" asp-route-modelName="@price.Model">调整此模型费率</a>
    </section>
}
