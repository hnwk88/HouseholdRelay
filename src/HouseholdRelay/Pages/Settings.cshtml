@page
@model SettingsModel
@{ ViewData["Title"] = "项目设置"; }
<p class="eyebrow">配置</p><h1>项目设置</h1>
<p>设置保存在本机，重启后仍然保留。监听端口和转发限制需重启服务生效。</p>
<partial name="_Notice" model="Model.Notice" />
<form method="post" class="card settings">
    <div asp-validation-summary="All" role="alert" tabindex="-1"></div><input type="hidden" asp-for="Version" />
    <label asp-for="Input.PublicUrl">对外地址（可稍后填写）</label>
    <input asp-for="Input.PublicUrl" type="url" maxlength="2048" placeholder="https://relay.example.com:5433" />
    <small>证书请在“HTTPS 入口”页导入；公网可达性需从实际客户端验证，保存地址不会建立公网映射。</small>
    <label asp-for="Input.ListenPort">中转监听端口</label><input asp-for="Input.ListenPort" type="number" min="@SettingLimits.ListenPort.Min" max="@SettingLimits.ListenPort.Max" required />
    <small>此端口用于已配置证书的中转入口；本机管理端口独立设置。</small>
    <fieldset aria-describedby="proxy-status"><legend>上游代理</legend>
        <p id="proxy-status">当前：@Model.ProxyStatus</p>
        <label class="checkbox"><input type="radio" id="proxy-none" asp-for="Input.ProxyMode" value="@(Wire<ProxyMode>.Name(ProxyMode.None))" />不使用代理</label>
        <label class="checkbox"><input type="radio" id="proxy-auto" asp-for="Input.ProxyMode" value="@(Wire<ProxyMode>.Name(ProxyMode.Auto))" />自动检测系统代理（推荐）</label>
        <label class="checkbox"><input type="radio" id="proxy-manual" asp-for="Input.ProxyMode" value="@(Wire<ProxyMode>.Name(ProxyMode.Manual))" />手动指定地址</label>
        <label asp-for="Input.ProxyUrl">代理地址（手动指定时使用）</label><input asp-for="Input.ProxyUrl" maxlength="2048" placeholder="http://127.0.0.1:7897" />
        <small>上游转发、获取模型、测试和 Claude Code 检测都用这一份。已启用代理却取不到地址时，请求会被拒绝，不会悄悄直连。</small>
    </fieldset>
    <fieldset aria-describedby="siyu-help"><legend>思域</legend>
        <label class="checkbox"><input asp-for="Input.SiyuEnabled" />接受新的思域会话</label>
        <label asp-for="Input.SiyuProxyPort">思域代理端口</label><input asp-for="Input.SiyuProxyPort" type="number" min="@SettingLimits.ListenPort.Min" max="@SettingLimits.ListenPort.Max" required />
        <small id="siyu-help">思域是 MyCoAI 里经中转使用官方账户的启动方式。打开后重启服务，中转才在这个端口接受思域连接；路由器要按同一个端口号转发到本机。关掉后不再接受新的思域会话，旧的接法照常。</small>
        <label class="checkbox"><input asp-for="Input.LegacyOfficialClosed" aria-describedby="legacy-help" />关闭旧接法的官方账户请求</label>
        <small id="legacy-help">旧接法是客户端把地址直接指向中转。勾上并重启后，旧接法的请求不再发往任何官方账户，只走独立 API 上游；家里每台电脑都改用思域之后再勾。</small>
    </fieldset>
    <details><summary>转发与限流设置</summary>
        <label asp-for="Input.MaxConcurrent">上游最大并发</label><input asp-for="Input.MaxConcurrent" type="number" min="@SettingLimits.MaxConcurrent.Min" max="@SettingLimits.MaxConcurrent.Max" required />
        <label asp-for="Input.MaxPerClient">每人最大并发</label><input asp-for="Input.MaxPerClient" type="number" min="@SettingLimits.MaxPerClient.Min" max="@SettingLimits.MaxPerClient.Max" required />
        <label asp-for="Input.MaxQueued">最大排队数</label><input asp-for="Input.MaxQueued" type="number" min="@SettingLimits.MaxQueued.Min" max="@SettingLimits.MaxQueued.Max" required />
        <label asp-for="Input.RequestsPerMinute">每人每分钟请求上限</label><input asp-for="Input.RequestsPerMinute" type="number" min="@SettingLimits.RequestsPerMinute.Min" max="@SettingLimits.RequestsPerMinute.Max" required />
        <label asp-for="Input.QueueTimeoutSeconds">排队超时（秒）</label><input asp-for="Input.QueueTimeoutSeconds" type="number" min="@SettingLimits.QueueTimeoutSeconds.Min" max="@SettingLimits.QueueTimeoutSeconds.Max" required />
        <label asp-for="Input.UploadTimeoutSeconds">上传超时（秒）</label><input asp-for="Input.UploadTimeoutSeconds" type="number" min="@SettingLimits.UploadTimeoutSeconds.Min" max="@SettingLimits.UploadTimeoutSeconds.Max" required />
        <label asp-for="Input.RequestTimeoutSeconds">上游请求超时（秒）</label><input asp-for="Input.RequestTimeoutSeconds" type="number" min="@SettingLimits.RequestTimeoutSeconds.Min" max="@SettingLimits.RequestTimeoutSeconds.Max" required />
        <label asp-for="Input.UpstreamUserAgent">上游 User-Agent</label><input asp-for="Input.UpstreamUserAgent" maxlength="256" required aria-describedby="upstream-agent-help" />
        <small id="upstream-agent-help">这个值只用在两种场合：API 密钥上游在客户端没带 User-Agent 时用它；兼容中转的账户令牌总用它。官方账户（登录、导入登录文件或贴官方账户令牌）总用中转所在电脑上 Claude Code 自己的身份，不用这个值。</small>
        <label class="checkbox"><input asp-for="Input.NormalizeDeviceMetadata" />兼容账户上游统一已识别的设备元数据（官方账户始终统一，API 模式不处理）</label>
    </details>
    <button type="submit">保存设置</button>
</form>
