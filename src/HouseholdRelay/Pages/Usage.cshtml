@page
@model UsageModel
@{ ViewData["Title"] = "用量"; }
<p class="eyebrow">调用记录</p><h1>个人用量</h1>
<p>保留最近 @UsageRetention.Days × 24 小时。时间按本机时区显示，清理按请求开始时间的 UTC 滚动窗口执行。</p>
<p>输入、输出和缓存列为上游报告的<strong>已知合计</strong>；缺失或不完整请求另列，未知不代表零。估算不计入推理消耗。</p>
<p>金额按“上游报告”和“估算”分别显示；估算仅计算 Token，不等于账单扣费。<a asp-page="/Pricing">配置模型估算费率</a></p>
<div asp-validation-summary="All" role="alert" tabindex="-1"></div>
<form method="get" class="card usage-filters" data-usage-filter>
    <input asp-for="TimeZone" type="hidden" data-timezone />
    <div><label asp-for="UserId">使用者</label><select asp-for="UserId"><option value="">全部使用者</option>@foreach (var user in Model.Users) { <option value="@user.Id">@user.DisplayName</option> }</select></div>
    <div><label asp-for="From">开始时间（含）</label><input asp-for="From" type="datetime-local" data-utc="@Model.From?.ToString("O")" /></div>
    <div><label asp-for="Until">结束时间（不含）</label><input asp-for="Until" type="datetime-local" data-utc="@Model.Until?.ToString("O")" /></div>
    <div><label asp-for="Kind">接口类别</label><select asp-for="Kind"><option value="">全部接口</option>@foreach (var kind in Wire<UsageKind>.Values) {<option value="@(Wire<UsageKind>.Name(kind))">@UsageLabels.Kind(kind)</option>}</select></div>
    <div><label asp-for="ModelName">模型（精确匹配）</label><input asp-for="ModelName" maxlength="@ModelName.MaxLength" /></div>
    <div><label asp-for="Outcome">结果</label><select asp-for="Outcome"><option value="">全部结果</option>@foreach (var outcome in Wire<UsageOutcome>.Values) {<option value="@(Wire<UsageOutcome>.Name(outcome))">@UsageLabels.Outcome(outcome)</option>}</select></div>
    <div><label asp-for="UpstreamCandidateId">上游</label><select asp-for="UpstreamCandidateId"><option value="">全部上游</option>@foreach (var item in Model.Upstreams) { <option value="@item.Id">@item.Name</option> }</select></div>
    <div><label asp-for="Granularity">时间统计</label><select asp-for="Granularity"><option value="day">按天</option><option value="hour">按小时</option></select></div>
    <div><button type="submit">查询用量</button> <a asp-page="/Usage">重置条件</a></div>
</form>
@if (Model.Report is { } report)
{
    @if (report.PersistenceFailures > 0) { <p role="alert" class="validation-summary-errors">用量保存或清理曾失败 @report.PersistenceFailures 次，请检查服务日志和数据目录。待写入记录不能视为完整统计。</p> }
    @if (Model.UpstreamText is { } only) { <p class="status">@only</p> }
    <p>当前窗口从 <time datetime="@report.WindowStart.ToString("O")">@report.WindowStart.ToLocalTime()</time> 起，共请求 @UsageLabels.Times(report.Total)。</p>
    @if (report.Total == 0) { <p class="notice">没有符合条件的请求记录。</p> }
    @foreach (var item in report.Summary)
    {
        <section class="card" data-usage-kind="@(Wire<UsageKind>.Name(item.Kind))"><h2>@UsageLabels.Kind(item.Kind)：请求 @UsageLabels.Times(item.Requests)</h2>
            <p>成功 @UsageLabels.Times(item.Succeeded)，失败 @UsageLabels.Times(item.Failed)，取消 @UsageLabels.Times(item.Cancelled)，中断 @UsageLabels.Times(item.Interrupted)，处理中 / 待写入 @UsageLabels.Times(item.Pending)，未发送 @UsageLabels.Times(item.NotSent)</p>
            @if (item.Kind != UsageKind.Models) {
                <p>已知输入 <strong>@UsageLabels.Tokens(item.Tokens.Input)</strong>@if (item.Kind == UsageKind.Inference) { <span>，已知输出 <strong>@UsageLabels.Tokens(item.Tokens.Output)</strong></span> }</p>
                @if (item.Kind == UsageKind.Inference) { <p>缓存读取 @UsageLabels.Tokens(item.Tokens.CacheRead)，缓存写入 @UsageLabels.Tokens(item.Tokens.CacheWrite)</p> }
                <p>缺失 / 不完整 <strong>@UsageLabels.Times(item.Incomplete)</strong>。缓存列独立显示，不与普通输入相加。</p>
            } else { <p>Token：不适用</p> }
            <partial name="_MoneyTotals" model="item" />
        </section>
    }
    <h2>按@(report.Granularity == "hour" ? "小时" : "天")统计</h2><p>统计时区：@report.TimeZone；每个时间段按请求开始时间归属，汇总包含全部筛选结果。</p>
    <div class="table-scroll" tabindex="0" role="region" aria-label="按时间统计"><table>
        <thead><tr><th>时段开始</th><th>类型</th><th>请求 / 成功（次）</th><th>失败 / 取消 / 中断（次）</th><th>已知输入 / 输出（token）</th><th>缓存读 / 写（token）</th><th>用量不完整（次）</th><th>金额</th></tr></thead><tbody>
        @foreach (var period in report.Periods) {
            var item = period.Summary;
            <tr><td>@period.Start.ToString("yyyy-MM-dd HH:mm zzz")</td><td>@UsageLabels.Kind(item.Kind)</td><td>@UsageLabels.Count(item.Requests) / @UsageLabels.Count(item.Succeeded)</td><td>@UsageLabels.Count(item.Failed) / @UsageLabels.Count(item.Cancelled) / @UsageLabels.Count(item.Interrupted)</td>
                <td>@(item.Kind == UsageKind.Models ? "不适用" : UsageLabels.Count(item.Tokens.Input) + " / " + (item.Kind == UsageKind.Estimate ? "不适用" : UsageLabels.Count(item.Tokens.Output)))</td>
                <td>@(item.Kind == UsageKind.Inference ? UsageLabels.Count(item.Tokens.CacheRead) + " / " + UsageLabels.Count(item.Tokens.CacheWrite) : "不适用")</td>
                <td>@UsageLabels.Count(item.Incomplete)</td><td>@if (item.Kind == UsageKind.Inference) { <partial name="_MoneyTotals" model="item" /> } else { <span>不适用</span> }</td></tr>
        }
        </tbody></table></div>
    <h2>请求明细</h2><p>最后一列读出这次请求实际走的哪家上游、上游状态码、失败原因和耗时；没发往上游的读「未发往上游」。</p><div class="table-scroll" tabindex="0" role="region" aria-label="用量明细"><table>
        <thead><tr><th>时间</th><th>使用者 / 模型</th><th>接口 / 结果</th><th>发送 / 状态码</th><th>输入 / 输出（token）</th><th>缓存读 / 写（token）</th><th>金额</th><th>完整性 / 版本</th><th>上游 / 原因 / 耗时</th><th>请求编号</th></tr></thead><tbody>
        @foreach (var row in report.Rows)
        {
            <tr><td><time datetime="@row.StartedAt.ToString("O")">@row.StartedAt.ToLocalTime()</time></td>
                <td>@row.DisplayName<small>@(row.Model ?? "模型未知")</small></td>
                <td>@UsageLabels.Kind(row.Kind)<small>@UsageLabels.Outcome(row.Outcome)</small></td>
                <td>@(row.Dispatched ? "已尝试发送" : "未发送")<small>中转 @(row.StatusCode?.ToString() ?? "—") / 上游 @(row.UpstreamStatus?.ToString() ?? "—")</small></td>
                <td>@(row.Completeness == UsageCompleteness.NotApplicable ? "不适用" : UsageLabels.Count(row.Tokens.Input) + " / " + (row.Kind == UsageKind.Estimate ? "不适用" : UsageLabels.Count(row.Tokens.Output)))</td>
                <td>@(row.Kind == UsageKind.Inference && row.Dispatched ? UsageLabels.Count(row.Tokens.CacheRead) + " / " + UsageLabels.Count(row.Tokens.CacheWrite) : "不适用")</td>
                <td>@UsageLabels.Money(row.Money)</td>
                <td>@UsageLabels.Completeness(row.Completeness)<small>上游版本 @(row.UpstreamVersion?.ToString() ?? "未知")</small></td>
                <td data-upstream-attempts>@UsageLabels.Attempts(report.AttemptsOf(row.RequestId))</td><td><small>@row.RequestId</small></td></tr>
        }
        </tbody></table></div>
    <nav class="actions" aria-label="明细分页">
        @if (report.HasPrevious) { <a href="@Model.PageLink(report.Page - 1)">上一页</a> }
        <span>第 @report.Page 页，共 @Math.Max(report.TotalPages, 1) 页，每页 @report.PageSize 条</span>
        @if (report.HasNext) { <a href="@Model.PageLink(report.Page + 1)">下一页</a> }
    </nav>
}
<p>个人可在中转地址的 <code>/my-usage</code> 页面输入自己的令牌查询。</p>
<script src="~/usage-admin.js" asp-append-version="true" defer></script>
