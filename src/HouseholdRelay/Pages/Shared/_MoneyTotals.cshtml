@model Core.Usage.UsageSummary
@if (Model.Kind == Core.Usage.UsageKind.Inference)
{
    @if (Model.Money.Count == 0) { <p>金额：未知</p> }
    @foreach (var money in Model.Money)
    {
        <p>已知金额（@UsageLabels.MoneySource(money.Source)）<strong>@UsageLabels.Amount(money.Amount, money.Currency)</strong>，请求 @UsageLabels.Times(money.Requests)，其中不完整 @UsageLabels.Times(money.Incomplete)</p>
    }
    <p>金额未知 @UsageLabels.Times(Model.UnknownAmounts)。不同币种和来源分开统计。</p>
}
