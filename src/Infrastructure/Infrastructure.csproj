<Project Sdk="Microsoft.NET.Sdk">
  <!-- 外部技术实现：SQLite、DPAPI、证书、上游 HTTP、Claude Code 进程；实现 Application 定义的接口，Application 不引用本项目。 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- 纯托管 zstd 解压（无原生 dll），用于把官方账户上游用 zstd 压的响应解开后计量、脱敏，使发往官方的 Accept-Encoding 能与原生直连一致地带上 zstd。 -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Application/Application.csproj" />
    <ProjectReference Include="../Core/Core.csproj" />
    <ProjectReference Include="..\..\Helpers\Repositories\Repositories.EntityFrameworkCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tests" />
    <!-- 清单资源名沿用迁移前的 HouseholdRelay.ClientTrust.文件名，ClientTrustPackage 按此名读取。 -->
    <EmbeddedResource Include="Security/ClientTrust/*" LogicalName="HouseholdRelay.ClientTrust.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
