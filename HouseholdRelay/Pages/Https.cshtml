@page
@model HttpsModel
@{ ViewData["Title"] = "HTTPS 入口"; }
<p class="eyebrow">安全连接</p><h1>导入可信 HTTPS 证书</h1>
<p>证书需要覆盖你的公开域名，并受客户端系统信任。可继续使用已有 TCP 端口映射，由本程序完成 TLS 加密。</p>
<div asp-validation-summary="All" role="alert"></div>
@if (Model.Notice is not null) { <p class="notice" role="status">@Model.Notice</p> }
<section class="card"><h2>当前状态</h2>
    @if (Model.Info is { } info)
    {
        <p class="status">@(info.ValidUntil > DateTimeOffset.UtcNow ? "已导入通过系统信任检查的证书" : "证书已过期，请更新")</p>
        <p>域名：@info.Host；有效期至 @info.ValidUntil.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz")</p>
        <p>导入检查：@info.CheckedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz")</p>
    }
    else { <p class="status">@(Model.Legacy ? "旧版私有 CA 模式，需要客户端额外信任" : "尚未配置 HTTPS")</p> }
    <p>@(Model.Listening ? "本进程的 HTTPS 监听已启动。" : "本进程尚未启动 HTTPS 监听。") 公网可达性仍需从外部客户端验证。</p>
</section>
<form method="post" enctype="multipart/form-data" class="card settings">
    <input type="hidden" asp-for="Version" />
    <label asp-for="PublicUrl">可信 HTTPS 根地址</label><input asp-for="PublicUrl" type="url" required maxlength="2048" placeholder="https://relay.example.com:5433" />
    <label asp-for="ListenPort">本机中转监听端口</label><input asp-for="ListenPort" type="number" required min="1024" max="65535" />
    <small>映射的公开端口可以与本机监听端口不同。管理网页继续只绑定本机回环地址。</small>
    <label asp-for="CertificateFile">PFX 证书文件（含私钥及中间证书链）</label><input asp-for="CertificateFile" type="file" accept=".pfx,.p12" required />
    <label asp-for="Password">PFX 密码（无密码可留空）</label><input asp-for="Password" type="password" autocomplete="new-password" maxlength="1024" />
    <small>私钥加密保存在本机；密码不保存、不回填。不自动安装根证书。</small>
    <button type="submit">验证并保存证书</button>
</form>
