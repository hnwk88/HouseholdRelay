
# 本实例数据与可重建验证输出（台账 D-006：大体积证据验收后即删，不进仓库）
.state/
.relay-instance
# 旧版正式程序生成的真实旧库夹具要进仓库（tools/legacy-fixtures 生成，假密钥）
!tests/Tests/Fixtures/LegacyDatabases/*/.relay-instance
# 只读打开夹具库时 SQLite 会在旁边建 -wal/-shm，它们不属于夹具
tests/Tests/Fixtures/LegacyDatabases/*/relay.db-*
artifacts/

# 编辑器与构建输出
.vs/
bin/
obj/
*.user

# >>> 门禁引擎：本机运行时、报告与安装记录不进仓库（project install／upgrade 维护，uninstall 删掉这一段；别手改）
.gate-engine/
.gate-cache/
tools/gate-engine.install.json
tools/.gate-settings.lock
.githooks/*.before-gate-engine
.githooks/*.gate-engine.json
.githooks/*.gate-engine.lock
# <<< 门禁引擎
